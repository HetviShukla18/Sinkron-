# Copy this file to .env.local and configure your enquiry services.
# Supabase storage is required. Notifications run only after a successful save.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Server-only Meta WhatsApp Cloud API settings. All six are needed for alerts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Public Click-to-Chat only; this number does not send automatic notifications.
NEXT_PUBLIC_WHATSAPP_NUMBER=
